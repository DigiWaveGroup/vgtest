# VGW static site — Apache security configuration (example)
# Rename to .htaccess in the web root only if AllowOverride is enabled; otherwise put it in the vhost.
# Do NOT upload the _deploy folder itself to the web root.

ServerSignature Off
Options -Indexes -MultiViews
AddDefaultCharset utf-8

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Block hidden files, deploy notes and docs
RedirectMatch 404 /\.
RedirectMatch 404 ^/_deploy/
RedirectMatch 404 ^/_tools/
<FilesMatch "\.(md|example|py|csv|bak|orig|log)$">
  Require all denied
</FilesMatch>

# Static site: only GET/HEAD
<LimitExcept GET HEAD>
  Require all denied
</LimitExcept>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

ErrorDocument 404 /404.html

# In httpd.conf (server level, not .htaccess): ServerTokens Prod ; TraceEnable Off
# TLS (vhost): SSLProtocol -all +TLSv1.2 +TLSv1.3
