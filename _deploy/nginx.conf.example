# VGW static site — nginx security configuration (example)
# Copy the relevant parts into your server block. Do NOT upload the _deploy folder to the web root.

server {
    listen 80;
    server_name example.gov.tw;               # TODO: replace with the real domain
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.gov.tw;               # TODO: replace with the real domain
    root /var/www/vgw;                        # TODO: replace with the real path

    ssl_certificate     /etc/ssl/vgw/fullchain.pem;
    ssl_certificate_key /etc/ssl/vgw/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_session_tickets off;

    server_tokens off;                        # hide nginx version
    autoindex off;                            # no directory listing
    charset utf-8;

    # Security headers (always = also on error pages)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; upgrade-insecure-requests" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Block hidden files (.DS_Store, .git ...), deploy notes and docs
    location ~ /\.            { deny all; return 404; }
    location ^~ /_deploy/     { deny all; return 404; }
    location ^~ /_tools/      { deny all; return 404; }
    location ~* \.(md|example|py|csv|bak|orig|log)$ { deny all; return 404; }

    # Only allow GET/HEAD for a static site
    if ($request_method !~ ^(GET|HEAD)$) { return 405; }

    # Caching
    # (no add_header inside these locations, so the server-level security headers still apply)
    location ~* \.(webp|png|jpg|jpeg|svg|ico|css|js|pdf)$ { expires 30d; }

    error_page 404 /404.html;
    location / { try_files $uri $uri/ =404; }
}
# Note: if you ever add an add_header inside a location block, nginx stops inheriting the
# server-level add_header lines for that location — repeat the security headers there.
